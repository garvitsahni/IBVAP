# IBVAP Environment Configuration
# Copy this file to .env and adjust values as needed

# Database
DATABASE_URL=postgresql://ibvap:ibvap@localhost:5432/ibvap

# MinIO (local S3-compatible storage for clips)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ibvap-clips
MINIO_SECURE=false

# MediaMTX RTSP Server
RTSP_BASE_URL=rtsp://localhost:8554
CAMERA_1_URL=rtsp://localhost:8554/cam1
CAMERA_2_URL=rtsp://localhost:8554/cam2
CAMERA_3_URL=rtsp://localhost:8554/cam3

# Fusion Server API
FUSION_SERVER_HOST=0.0.0.0
FUSION_SERVER_PORT=8000

# Edge Node Config
EDGE_NODE_ID=edge-01
EDGE_CAMERA_IDS=cam1,cam2,cam3

# Detection/Tracking (Phase 1)
YOLO_MODEL=yolov8n.pt
CONF_THRESHOLD=0.3
IOU_THRESHOLD=0.5
BYTE_TRACK_MAX_AGE=30
BYTE_TRACK_MIN_HITS=3

# Re-ID (Phase 2)
REID_MODEL=osnet_x1_0
REID_THRESHOLD=0.75

# Ledger (Phase 3)
LEDGER_HASH_ALGO=sha256

# AI Enrichment (Phase 4) - Local LLM/VLM
AI_ENRICHMENT_ENABLED=false
AI_MODEL_PATH=./models/llm

# Logging
LOG_LEVEL=INFO